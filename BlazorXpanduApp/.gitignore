## .NET Core gitignore

# Files to ignore
bin/
obj/
*.user
*.suo
*.cache
*.log
*.pdb
*.dll
*.exe

# Visual Studio files
.vs/
*.vspscc

# Rider files
.idea/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Mac
.DS_Store

# NPM
node_modules/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
