@page "/analisis"
@using Syncfusion.Blazor.Popups
@inject XpanduService XpanduService
@inject NavigationManager Navigation

<PageTitle>Análisis IA - BlazorXpanduApp</PageTitle>

<h1>🤖 Análisis con Inteligencia Artificial</h1>

<div class="analisis-container">
    <div class="card">
        <h3>Analizar imagen con XpandU AI</h3>
        
        @if (!string.IsNullOrEmpty(imagenBase64))
        {
            <div class="imagen-preview">
                <img src="@imagenBase64" alt="Imagen a analizar" />
            </div>
        }
        else
        {
            <div class="upload-section">
                <p>Sube una imagen o documento para analizar</p>
                <input type="file" accept="image/*" @onchange="OnFileSelected" class="form-control" />
            </div>
        }

        <div class="mt-3">
            <label for="prompt">Instrucciones para la IA:</label>
            <textarea id="prompt" @bind="prompt" rows="3" class="form-control" 
                      placeholder="Describe qué quieres que analice la IA. Ej: 'Extrae el texto de este documento', '¿Qué información contiene esta imagen?'"></textarea>
        </div>

        <div class="button-group mt-3">
            <SfButton CssClass="e-btn e-primary" OnClick="AnalizarImagen" Disabled="@(!puedeAnalizar)">
                🚀 Analizar con IA
            </SfButton>
            <SfButton CssClass="e-btn e-secondary" OnClick="LimpiarTodo">
                🗑 Limpiar
            </SfButton>
        </div>
    </div>

    @if (analizando)
    {
        <div class="card mt-3 loading">
            <div class="spinner"></div>
            <p>Analizando imagen con XpandU AI...</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultadoAnalisis))
    {
        <div class="card mt-3 resultado">
            <h3>📊 Resultado del Análisis</h3>
            <div class="resultado-content">
                @((MarkupString)resultadoAnalisis)
            </div>
            
            @if (!string.IsNullOrEmpty(razonamiento))
            {
                <details class="mt-3">
                    <summary>Ver proceso de razonamiento</summary>
                    <p class="razonamiento">@razonamiento</p>
                </details>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="card mt-3 error">
            <h3>❌ Error</h3>
            <p>@error</p>
        </div>
    }
</div>

@code {
    private string? imagenBase64;
    private string prompt = "Analiza esta imagen y describe su contenido en detalle.";
    private bool analizando = false;
    private string resultadoAnalisis = "";
    private string razonamiento = "";
    private string error = "";
    private bool puedeAnalizar => !string.IsNullOrEmpty(imagenBase64) && !analizando;

    protected override void OnInitialized()
    {
        // Verificar si viene una imagen por parámetro URL
        var uri = Navigation.Uri;
        if (uri.Contains("?imagen="))
        {
            var query = uri.Split('?')[1];
            var parameters = System.Web.HttpUtility.ParseQueryString(query);
            imagenBase64 = parameters["imagen"];
        }
    }

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        if (e.File != null)
        {
            using var memoryStream = new MemoryStream();
            await ((IBrowserFile)e.File).OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)
                .CopyToAsync(memoryStream);
            
            var bytes = memoryStream.ToArray();
            imagenBase64 = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
            error = "";
            resultadoAnalisis = "";
        }
    }

    private async Task AnalizarImagen()
    {
        if (string.IsNullOrEmpty(imagenBase64)) return;

        analizando = true;
        error = "";
        resultadoAnalisis = "";
        razonamiento = "";

        try
        {
            // Extraer solo el base64 (sin el prefix data:image/...)
            var base64Data = imagenBase64.Split(',')[1];
            
            var resultado = await XpanduService.AnalizarImagenAsync(base64Data, prompt);
            
            resultadoAnalisis = resultado.Contenido;
            razonamiento = resultado.Razonamiento ?? "";
        }
        catch (Exception ex)
        {
            error = $"Error al analizar: {ex.Message}";
        }
        finally
        {
            analizando = false;
        }
    }

    private void LimpiarTodo()
    {
        imagenBase64 = null;
        prompt = "Analiza esta imagen y describe su contenido en detalle.";
        resultadoAnalisis = "";
        razonamiento = "";
        error = "";
    }
}
